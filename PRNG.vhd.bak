LIBRARY ieee;
USE ieee.std_logic_1164.all; 

LIBRARY work;

ENTITY PRNG IS 
	PORT
	(
		clock :  IN  STD_LOGIC;
		key0 :  IN  STD_LOGIC;
		output_valid :  OUT  STD_LOGIC;
		delay_value :  OUT  STD_LOGIC_VECTOR(7 DOWNTO 0);
		random_value :  OUT  STD_LOGIC_VECTOR(63 DOWNTO 0)
	);
END PRNG;

ARCHITECTURE bdf_type OF PRNG IS 

COMPONENT top_xoroshiro
	PORT(clk : IN STD_LOGIC;
		 rst : IN STD_LOGIC;
		 ready : IN STD_LOGIC;
		 valid : OUT STD_LOGIC;
		 data : OUT STD_LOGIC_VECTOR(63 DOWNTO 0)
	);
END COMPONENT;

COMPONENT reg8
	PORT(Resetn : IN STD_LOGIC;
		 Clock : IN STD_LOGIC;
		 D : IN STD_LOGIC_VECTOR(63 DOWNTO 0);
		 Q : OUT STD_LOGIC_VECTOR(7 DOWNTO 0)
	);
END COMPONENT;

SIGNAL	SYNTHESIZED_WIRE_0 :  STD_LOGIC;
SIGNAL	SYNTHESIZED_WIRE_1 :  STD_LOGIC;
SIGNAL	SYNTHESIZED_WIRE_2 :  STD_LOGIC_VECTOR(63 DOWNTO 0);


BEGIN 
random_value <= SYNTHESIZED_WIRE_2;
SYNTHESIZED_WIRE_0 <= '0';
SYNTHESIZED_WIRE_1 <= '1';



b2v_inst : top_xoroshiro
PORT MAP(clk => clock,
		 rst => SYNTHESIZED_WIRE_0,
		 ready => SYNTHESIZED_WIRE_1,
		 valid => output_valid,
		 data => SYNTHESIZED_WIRE_2);




b2v_inst4 : reg8
PORT MAP(Resetn => key0,
		 Clock => key0,
		 D => SYNTHESIZED_WIRE_2,
		 Q => delay_value);


END bdf_type;