LIBRARY ieee;
USE ieee.std_logic_1164.all; 

LIBRARY work;

ENTITY w_signal_trigger_circuit IS 
	PORT
	(
		Key0 :  IN  STD_LOGIC;
		clk_1KHZ :  IN  STD_LOGIC;
		clk_100HZ :  IN  STD_LOGIC;
		delay_value :  IN  STD_LOGIC_VECTOR(7 DOWNTO 0);
		W :  OUT  STD_LOGIC
	);
END w_signal_trigger_circuit;

ARCHITECTURE bdf_type OF w_signal_trigger_circuit IS 

COMPONENT os1
	PORT(clock : IN STD_LOGIC;
		 trigger : IN STD_LOGIC;
		 reset : IN STD_LOGIC;
		 delay : IN STD_LOGIC_VECTOR(7 DOWNTO 0);
		 q : OUT STD_LOGIC
	);
END COMPONENT;

COMPONENT os2
	PORT(clock : IN STD_LOGIC;
		 trigger : IN STD_LOGIC;
		 reset : IN STD_LOGIC;
		 delay : IN STD_LOGIC_VECTOR(7 DOWNTO 0);
		 q : OUT STD_LOGIC
	);
END COMPONENT;

SIGNAL	delay :  STD_LOGIC_VECTOR(7 DOWNTO 0);
SIGNAL	vcc :  STD_LOGIC;
SIGNAL	SYNTHESIZED_WIRE_0 :  STD_LOGIC;


BEGIN 






b2v_OS1 : os1
PORT MAP(clock => clk_100HZ,
		 trigger => Key0,
		 reset => vcc,
		 delay => delay_value,
		 q => SYNTHESIZED_WIRE_0);


b2v_OS2 : os2
PORT MAP(clock => clk_1KHZ,
		 trigger => SYNTHESIZED_WIRE_0,
		 reset => vcc,
		 delay => delay_value,
		 q => W);


delay(7 DOWNTO 1) <= "0000000";
delay(0) <= '1';
vcc <= '1';
END bdf_type;